  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string",
            "maxLength" : 32,
            "minLength" : 4
          }
        },
        "required" : [ "newPassword" ]
      },
      "EntityMetaData" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdBy" : {
            "type" : "string"
          },
          "lastModifiedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastModifiedBy" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "createdBy", "lastModifiedAt", "lastModifiedBy" ]
      },
      "UserAccount" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string"
          },
          "lastName" : {
            "type" : "string"
          },
          "roles" : {
