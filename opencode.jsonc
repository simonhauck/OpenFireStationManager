{
	// https://opencode.ai/config.json
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		// The MCP endpoint hosted by a locally running OFSM server. On first use OpenCode
		// registers itself with the OpenID Connect provider (local Keycloak) and opens the
		// browser to sign in; no cookies or tokens are copied by hand. See server/AGENTS.md
		// ("Consuming the API over MCP").
		"ofsm-api": {
			"type": "remote",
			"url": "http://localhost:8080/mcp",
			"enabled": false
		},
		"playwright": {
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp"]
		},
		// Component docs, templates, and design tokens for the Astryx design system.
		// Two tools: search(query) and get(name, section). See client/AGENTS.md.
		"astryx": {
			"type": "remote",
			"url": "https://astryx.atmeta.com/mcp",
			"enabled": true
		},
		"terraform": {
			"type": "local",
			"command": [
				"docker",
				"run",
				"-i",
				"--rm",
				"-e",
				"TFE_TOKEN",
				"-e",
				"TFE_ADDRESS",
				"hashicorp/terraform-mcp-server:0.5.2"
			],
			"enabled": true
		}
	}
}
