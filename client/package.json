{
  "name": "open-fire-station-manager",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests",
    "format:check": "biome check .",
    "format:fix": "biome check --write .",
    "build:check": "tsc --noEmit",
    "prepareEnv": "npx openapi-typescript ./../server/src/main/resources/open-api-contract.json -o ./src/api/schema.ts && biome format --write ./src/api/schema.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.6",
    "@astryxdesign/theme-neutral": "^0.6.6",
    "@stylexjs/stylex": "^0.19.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.6",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.59.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-plugin": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
